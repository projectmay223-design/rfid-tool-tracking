    {
      "name": "Error Cases",
      "description": "Test all mandatory error scenarios.",
      "item": [
        {
          "name": "Access Protected Route Without Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tools",
              "host": ["{{baseUrl}}"],
