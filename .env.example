# ============================================================
# RFID Tool Tracking System — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# PostgreSQL connection string (required)
# Railway provides this automatically when you add a PostgreSQL plugin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT signing secret — use a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Server port (Railway sets this automatically — do not override)
PORT=8080

# Node environment
NODE_ENV=production

# Optional: Restrict CORS to a specific origin (e.g. your frontend domain)
# Leave empty to allow all origins (fine when backend serves the frontend)
# CORS_ORIGIN=https://your-app.railway.app
